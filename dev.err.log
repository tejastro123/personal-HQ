    '                  className="flex gap-3 rounded-xl border border-border bg-card/70 p-3.5 shadow-[var(--shadow-border)]"\n' +
    '                >\n' +
    '                  <span className="mono mt-0.5 text-[11px] text-accent">\n' +
    '                    {String(i + 1).padStart(2, "0")}\n' +
    '                  </span>\n' +
    '                  <div>\n' +
    '                    <p className="text-sm font-medium text-foreground">{step.title}</p>\n' +
    '                    <p className="mt-0.5 text-sm text-muted-foreground">{step.body}</p>\n' +
    '                  </div>\n' +
    '                </li>\n' +
    '              ))}\n' +
    '            </ul>\n' +
    '          </div>\n' +
    '        </Reveal>\n' +
    '        <Reveal delay={0.08} className="lg:col-span-7">\n' +
