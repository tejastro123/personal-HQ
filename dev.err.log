  pluginCode: 'import { zodResolver } from "@hookform/resolvers/zod";\n' +
    'import { useState, type ReactNode, type SelectHTMLAttributes } from "react";\n' +
    'import { useForm } from "react-hook-form";\n' +
    'import { z } from "zod";\n' +
    'import { ArrowRight, CheckCircle2, Mail, ShieldCheck, Sparkles } from "lucide-react";\n' +
    'import { Button } from "@/components/ui/button";\n' +
    'import { Input } from "@/components/ui/input";\n' +
    'import { Label } from "@/components/ui/label";\n' +
    'import { Textarea } from "@/components/ui/textarea";\n' +
    'import { Reveal, SectionHeading } from "@/components/reveal";\n' +
    'import { budgetScopes, projectTypes } from "@/data/content";\n' +
    'import { contactEndpoint, site } from "@/data/site";\n' +
    'import { persistContactMessage, usePublicSiteSettings } from "@/lib/use-public-content";\n' +
    'import { cn } from "@/lib/utils";\n' +
    '\n' +
    'const schema = z.object({\n' +
    '  name: z.string().min(2, "Please enter your name"),\n' +
    '  email: z.email("Enter a valid email"),\n' +
    '  projectType: z.string().min(1, "Select a project type"),\n' +
    '  budget: z.string().min(1, "Select a scope"),\n' +
    '  message: z.string().min(12, "Tell me a little more about the idea"),\n' +
    '});\n' +
    '\n' +
    'type FormValues = z.infer<typeof schema>;\n' +
    'type Status = "idle" | "loading" | "success" | "error";\n' +
    'type Delivery = "formspree" | "email" | "inbox";\n' +
    '\n' +
    'const PROCESS_STEPS = [\n' +
    '  {\n' +
    '    title: "Read",\n' +
    '    body: "I review the brief and reply with questions if anything is unclear.",\n' +
    '  },\n' +
    '  {\n' +
    '    title: "Scope",\n' +
    '    body: "We align on stack, timeline, and what “done” actually means.",\n' +
    '  },\n' +
    '  {\n' +
    '    title: "Build",\n' +
    '    body: "Shipping in public where possible — demos, repos, and honest progress.",\n' +
    '  },\n' +
    '] as const;\n' +
    '\n' +
    'export function Contact({ standalone = false }: { standalone?: boolean }) {\n' +
    '  const [status, setStatus] = useState<Status>("idle");\n' +
    '  const [delivery, setDelivery] = useState<Delivery>("email");\n' +
    '  const [persistError, setPersistError] = useState<string | null>(null);\n' +
    '  const settings = usePublicSiteSettings();\n' +
    '  const endpoint = settings.formspreeId\n' +
    '    ? `https://formspree.io/f/${settings.formspreeId}`\n' +
    '    : contactEndpoint();\n' +
    '  const form = useForm<FormValues>({\n' +
    '    resolver: zodResolver(schema),\n' +
    '    defaultValues: {\n' +
    '      name: "",\n' +
    '      email: "",\n' +
    '      projectType: "",\n' +
    '      budget: "",\n' +
    '      message: "",\n' +
    '    },\n' +
    '  });\n' +
    '\n' +
    '  const projectType = form.watch("projectType");\n' +
    '\n' +
    '  async function onSubmit(values: FormValues) {\n' +
    '    setStatus("loading");\n' +
    '    setPersistError(null);\n' +
    '    const subject = `[${values.projectType}] Message from ${values.name}`;\n' +
    '    const body = `Name: ${values.name}\\nEmail: ${values.email}\\nProject type: ${values.projectType}\\nScope: ${values.budget}\\n\\n${values.message}`;\n' +
    '    try {\n' +
    '      const persisted = await persistContactMessage({\n' +
    '        name: values.name,\n' +
    '        email: values.email,\n' +
    '        subject,\n' +
    '        message: body,\n' +
    '      });\n' +
    '      if (!persisted.ok) {\n' +
    '        setPersistError(persisted.error);\n' +
    '        setStatus("error");\n' +
    '        return;\n' +
    '      }\n' +
    '\n' +
    '      if (endpoint) {\n' +
    '        const res = await fetch(endpoint, {\n' +
    '          method: "POST",\n' +
    '          headers: {\n' +
    '            "Content-Type": "application/json",\n' +
    '            Accept: "application/json",\n' +
    '          },\n' +
    '          body: JSON.stringify(values),\n' +
    '        });\n' +
    '        if (!res.ok) {\n' +
    '          if (persisted.ok) {\n' +
    '            setDelivery("inbox");\n' +
    '            setStatus("success");\n' +
    '            form.reset();\n' +
    '            return;\n' +
    '          }\n' +
    '          let detail = `Formspree ${res.status}`;\n' +
    '          try {\n' +
    '            const data = (await res.json()) as { error?: string };\n' +
    '            if (data?.error) detail = `${detail}: ${data.error}`;\n' +
    '          } catch {\n' +
    '            /* keep status-only message */\n' +
    '          }\n' +
    '          throw new Error(detail);\n' +
    '        }\n' +
    '        setDelivery("formspree");\n' +
    '        setStatus("success");\n' +
    '        form.reset();\n' +
    '        return;\n' +
    '      }\n' +
    '\n' +
    '      window.location.href = `mailto:${settings.email || site.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;\n' +
    '\n' +
    '      const key = "tejas-contact-drafts";\n' +
    '      const prev = JSON.parse(localStorage.getItem(key) || "[]") as unknown[];\n' +
    '      localStorage.setItem(\n' +
    '        key,\n' +
    '        JSON.stringify([{ ...values, at: new Date().toISOString() }, ...prev].slice(0, 20)),\n' +
    '      );\n' +
    '      setDelivery(persisted.ok ? "inbox" : "email");\n' +
    '      setStatus("success");\n' +
    '      form.reset();\n' +
    '    } catch {\n' +
    '      setStatus("error");\n' +
    '    }\n' +
    '  }\n' +
    '\n' +
    '  return (\n' +
    '    <section\n' +
    '      id="contact"\n' +
    '      className={cn(\n' +
    '        "scroll-mt-24 border-t border-border py-20 sm:py-28",\n' +
    '        standalone && "border-t-0",\n' +
    '      )}\n' +
    '    >\n' +
    '      <div className="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-12">\n' +
    '        <Reveal className="lg:col-span-5">\n' +
    '          <SectionHeading\n' +
    '            eyebrow="Contact"\n' +
    '            title={settings.home.contactTitle || "Start a conversation."}\n' +
    '            subtitle={\n' +
    '              settings.home.contactSubtitle ||\n' +
    '              (endpoint\n' +
    '                ? "This form sends straight to my inbox. Prefer email? The address below always works."\n' +
    '                : "Submit to save a note in the studio inbox and open a prefilled email — no account required. You can also write me directly.")\n' +
    '            }\n' +
    '          />\n' +
    '          {settings.email || site.email ? (\n' +
    '            <a\n' +
    '              href={`mailto:${settings.email || site.email}`}\n' +
    '              className="mt-4 inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1.5 text-sm text-foreground shadow-[var(--shadow-border)] underline-offset-4 hover:border-accent/40 hover:bg-accent-soft hover:no-underline"\n' +
    '            >\n' +
    '              <Mail className="size-3.5 text-accent" />\n' +
    '              {settings.email || site.email}\n' +
    '            </a>\n' +
    '          ) : null}\n' +
    '          <div className="mt-8 space-y-3">\n' +
    '            <p className="mono text-[11px] uppercase tracking-[0.18em] text-subtle">\n' +
    '              What happens next\n' +
    '            </p>\n' +
    '            <ul className="space-y-3">\n' +
    '              {PROCESS_STEPS.map((step, i) => (\n' +
    '                <li\n' +
