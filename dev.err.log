    '              <p className="mt-3 text-sm text-muted-foreground">\n' +
    '                {delivery === "formspree"\n' +
    `                  ? "Thanks — I'll get back to you as soon as I can."\n` +
    '                  : delivery === "inbox"\n' +
    `                    ? "Your note is in the studio inbox. You can also email directly if it's urgent."\n` +
